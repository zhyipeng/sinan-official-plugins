{
  "id": "tools.clipboard",
  "name": "剪贴板",
  "version": "0.2.0",
  "apiVersion": "1",
  "icon": "icon.svg",
  "runtime": {
    "kind": "process",
    "entry": "backend/plugin"
  },
  "contributes": {
    "commands": [
      {
        "id": "open",
        "title": "剪贴板历史",
        "keywords": [
          "clipboard",
          "粘贴",
          "历史"
        ],
        "uiView": "history",
        "shortcut": "CmdOrCtrl+Shift+V"
      },
      {
        "id": "list",
        "title": "读取历史",
        "searchOnly": true
      },
      {
        "id": "preview",
        "title": "预览图片",
        "searchOnly": true
      },
      {
        "id": "select",
        "title": "复制条目",
        "searchOnly": true
      },
      {
        "id": "delete",
        "title": "删除条目",
        "searchOnly": true
      },
      {
        "id": "clear",
        "title": "清空历史",
        "searchOnly": true
      }
    ],
    "uiViews": [
      {
        "id": "history",
        "entry": "index.html",
        "bridgeVersion": "2",
        "commands": [
          "list",
          "preview",
          "select",
          "delete",
          "clear"
        ],
        "permissions": [
          "input.paste"
        ]
      }
    ]
  },
  "permissions": [
    "clipboard.read",
    "clipboard.write"
  ],
  "activationEvents": [
    "onStartup",
    "onCommand:open"
  ]
}
