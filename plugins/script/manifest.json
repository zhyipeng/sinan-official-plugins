{
  "id": "tools.script",
  "name": "脚本",
  "version": "0.2.0",
  "apiVersion": "1",
  "icon": "icon.svg",
  "runtime": {
    "kind": "process",
    "entry": "backend/plugin"
  },
  "contributes": {
    "commands": [
      {"id": "open", "title": "脚本", "keywords": ["script", "脚本管理", "运行脚本"], "uiView": "library"},
      {"id": "run", "title": "运行脚本", "searchOnly": true, "execution": "direct"},
      {"id": "list", "title": "查询脚本", "searchOnly": true},
      {"id": "settings", "title": "读取脚本设置", "searchOnly": true},
      {"id": "change", "title": "修改脚本设置", "searchOnly": true},
      {"id": "run-view", "title": "查看脚本输出", "searchOnly": true, "uiView": "library"},
      {"id": "start", "title": "启动脚本", "searchOnly": true},
      {"id": "start-output", "title": "启动并查看输出", "searchOnly": true},
      {"id": "run-status", "title": "读取脚本运行结果", "searchOnly": true}
    ],
    "searchProviders": [{"id": "scripts", "minLength": 1}],
    "uiViews": [
      {
        "id": "library",
        "title": "脚本",
        "entry": "index.html",
        "bridgeVersion": "2",
        "commands": ["list", "settings", "change", "start", "start-output", "run-status"],
        "permissions": ["file.pickPath"]
      }
    ]
  },
  "permissions": ["notifications.send"],
  "activationEvents": ["onSearch", "onCommand:open"]
}
