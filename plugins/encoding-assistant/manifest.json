{
  "id": "tools.encoding-assistant",
  "name": "编码助手",
  "version": "0.1.1",
  "apiVersion": "1",
  "icon": "icon.svg",
  "runtime": {"kind": "declarative"},
  "contributes": {
    "commands": [
      {
        "id": "time", "title": "时间转换", "keywords": ["编码助手", "时间戳", "timestamp", "Unix", "UTC", "时区"], "uiView": "time",
        "inputMatchers": [
          {"kind": "regex", "pattern": "^[[:space:]]*[+-]?(?:[0-9]{10}|[0-9]{13})[[:space:]]*$", "maxLength": 64},
          {"kind": "regex", "pattern": "(?i)^[[:space:]]*[0-9]{4}[-/][0-9]{1,2}[-/][0-9]{1,2}(?:[ T][0-9]{1,2}:[0-9]{2}(?::[0-9]{2}(?:\\.[0-9]{1,3})?)?(?: ?(?:Z|[+-][0-9]{2}:?[0-9]{2}))?)?[[:space:]]*$", "maxLength": 96}
        ]
      },
      {"id": "base64", "title": "Base64 编码 / 解码", "keywords": ["编码助手", "Base64"], "uiView": "text"},
      {"id": "uuid", "title": "生成 UUID", "keywords": ["编码助手", "UUID", "GUID"], "uiView": "text"},
      {"id": "hash", "title": "Hash 计算", "keywords": ["编码助手", "哈希", "散列", "MD5", "SHA-1", "SHA-256", "SHA-384", "SHA-512"], "uiView": "text"},
      {
        "id": "qr", "title": "二维码编码 / 解码", "keywords": ["编码助手", "二维码", "QR Code"], "uiView": "qr",
        "inputMatchers": [
          {"kind": "regex", "pattern": "(?i)^[[:space:]]*https?://[^[:space:]/?#]+[^[:space:]]*[[:space:]]*$", "maxLength": 2048},
          {"kind": "image"}
        ]
      }
    ],
    "uiViews": [
      {"id": "time", "entry": "index.html", "bridgeVersion": "2", "permissions": ["storage", "clipboard.write"]},
      {"id": "text", "entry": "index.html", "bridgeVersion": "2", "permissions": ["clipboard.write"]},
      {"id": "qr", "entry": "index.html", "bridgeVersion": "2", "permissions": ["clipboard.write", "clipboard.read", "file.openImage"]}
    ]
  },
  "permissions": [],
  "activationEvents": ["onCommand:time", "onCommand:base64", "onCommand:uuid", "onCommand:hash", "onCommand:qr"]
}
