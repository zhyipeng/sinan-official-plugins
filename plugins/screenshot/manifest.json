{
  "id": "tools.screenshot",
  "name": "截图",
  "version": "0.3.0",
  "apiVersion": "1",
  "icon": "icon.svg",
  "runtime": {
    "kind": "process",
    "entry": "backend/plugin"
  },
  "contributes": {
    "commands": [
      {
        "id": "capture",
        "title": "截图",
        "keywords": [
          "截图",
          "截屏",
          "screenshot",
          "区域截图"
        ],
        "uiView": "capture",
        "startHidden": true,
        "shortcut": "CmdOrCtrl+Shift+A"
      },
      {
        "id": "cancel",
        "title": "cancel",
        "searchOnly": true
      },
      {
        "id": "read",
        "title": "read",
        "searchOnly": true
      },
      {
        "id": "copy",
        "title": "copy",
        "searchOnly": true
      },
      {
        "id": "capture-region",
        "title": "执行区域截图",
        "searchOnly": true
      }
    ],
    "uiViews": [
      {
        "id": "capture",
        "entry": "index.html",
        "bridgeVersion": "2",
        "commands": [
          "capture-region",
          "read",
          "copy",
          "cancel"
        ],
        "permissions": [
          "window.execute",
          "window.show",
          "window.hide"
        ],
        "dependencies": [
          "ocr"
        ]
      }
    ]
  },
  "permissions": [
    "clipboard.write"
  ],
  "activationEvents": [
    "onCommand:capture"
  ],
  "dependencies": [
    {
      "id": "ocr",
      "pluginId": "tools.ocr",
      "minVersion": "0.3.0",
      "optional": true,
      "entries": [
        {
          "id": "recognize-image",
          "version": "1"
        }
      ]
    }
  ]
}
