{
  "id": "tools.ocr",
  "name": "文字识别",
  "version": "0.2.0",
  "apiVersion": "1",
  "icon": "icon.svg",
  "runtime": {
    "kind": "process",
    "entry": "backend/plugin"
  },
  "contributes": {
    "commands": [
      {
        "id": "open",
        "title": "图片文字识别",
        "keywords": [
          "ocr",
          "文字提取",
          "截图识别"
        ],
        "uiView": "recognize",
        "inputMatchers": [
          {
            "kind": "image"
          }
        ]
      },
      {
        "id": "start",
        "title": "开始识别",
        "searchOnly": true
      },
      {
        "id": "poll",
        "title": "读取识别结果",
        "searchOnly": true
      },
      {
        "id": "cancel",
        "title": "取消识别",
        "searchOnly": true
      }
    ],
    "uiViews": [
      {
        "id": "recognize",
        "entry": "index.html",
        "bridgeVersion": "2",
        "commands": [
          "start",
          "poll",
          "cancel"
        ],
        "permissions": [
          "clipboard.write",
          "clipboard.read"
        ]
      }
    ]
  },
  "permissions": [
    "clipboard.read"
  ],
  "activationEvents": [
    "onCommand:open"
  ]
}
