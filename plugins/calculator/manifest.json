{
  "id": "tools.calculator",
  "name": "计算",
  "version": "0.1.0",
  "apiVersion": "1",
  "icon": "icon.svg",
  "runtime": {
    "kind": "process",
    "entry": "backend/plugin"
  },
  "contributes": {
    "commands": [
      {
        "id": "open",
        "title": "计算稿纸",
        "keywords": [
          "计算",
          "calculator",
          "calc",
          "稿纸"
        ],
        "uiView": "paper"
      },
      {
        "id": "copy",
        "title": "复制计算结果",
        "execution": "direct",
        "searchOnly": true
      },
      {
        "id": "evaluate",
        "title": "计算表达式",
        "searchOnly": true
      }
    ],
    "searchProviders": [
      {
        "id": "expressions",
        "minLength": 2
      }
    ],
    "uiViews": [
      {
        "id": "paper",
        "entry": "index.html",
        "bridgeVersion": "2",
        "commands": [
          "evaluate",
          "copy"
        ],
        "permissions": [
          "storage"
        ]
      }
    ]
  },
  "permissions": [
    "clipboard.write"
  ],
  "activationEvents": [
    "onSearch",
    "onCommand:open"
  ]
}
